# Gloo API key. GLOO_API_KEY is also accepted.
API_KEY=replace-with-your-gloo-api-key

# Publisher metadata used by the application and upload utilities.
PUBLISHER_NAME=your-publisher-name
PUBLISHER_ID=your-publisher-id

# Optional model override.
MODEL=gloo-openai-gpt-5.6-luna

# Daily crawler (SQLite is appropriate for the current single-host deployment).
CRAWL_STATE_DB=app/uploaders/crawl_state.sqlite3
CRAWL_OUTPUT_DIR=app/scraped_pages
CRAWL_TIMEZONE=Asia/Calcutta
